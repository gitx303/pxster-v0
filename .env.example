# Copy to .env; replace all placeholders before production use.
ENVIRONMENT=production
APP_ORIGIN=https://app.pxster.xyz
API_URL=https://api.pxster.xyz
MEDIA_URL=https://media.pxster.xyz
DEMO_MODE=false
ALLOW_REGISTRATION=true
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://pxster:replace-with-a-long-random-password@db:5432/pxster
# Generate with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
STORAGE_DRIVER=r2
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=pxster-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Remote-managed Cloudflare Tunnel. Set public hostname api.pxster.xyz -> http://api:8000.
TUNNEL_TOKEN=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
